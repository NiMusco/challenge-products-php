#!/bin/sh
set -e

cd "$(dirname "$0")/.."

TEST_SERVER_HOST="${TEST_SERVER_HOST:-127.0.0.1}"
TEST_SERVER_PORT="${TEST_SERVER_PORT:-8091}"

php bin/ensure-testing-database.php

# Dedicated PHP built-in server → Docker db_test (Apache keeps using service "db")
export DB_HOST="${DB_TEST_HOST:-db_test}"
export DB_PORT="${DB_TEST_PORT:-3306}"
export DB_DATABASE="${DB_TEST_DATABASE:-productos}"
export DB_USERNAME="${DB_USERNAME:-productos}"
export DB_PASSWORD="${DB_PASSWORD:-secret}"
export PRECIO_USD="${PRECIO_USD:-1500}"
export API_BASE_URL="http://${TEST_SERVER_HOST}:${TEST_SERVER_PORT}"

php -S "${TEST_SERVER_HOST}:${TEST_SERVER_PORT}" -t public >/tmp/pest-server.log 2>&1 &
SERVER_PID=$!

cleanup() {
  kill "$SERVER_PID" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

i=0
while [ "$i" -lt 50 ]; do
  if php -r "exit(@file_get_contents(getenv('API_BASE_URL') . '/productos') === false ? 1 : 0);"; then
    break
  fi
  i=$((i + 1))
  sleep 0.1
done

if [ "$i" -eq 50 ]; then
  echo "Pest test server failed to start. Log:" >&2
  cat /tmp/pest-server.log >&2 || true
  exit 1
fi

./vendor/bin/pest "$@"
