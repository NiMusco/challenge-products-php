{
    "name": "challenge/products-api",
    "description": "Native PHP REST API for products",
    "type": "project",
    "require": {
        "php": "^8.2",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3"
    },
    "require-dev": {
        "pestphp/pest": "^2.36"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Utils/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bash bin/test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
